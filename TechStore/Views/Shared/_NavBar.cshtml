@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
}

<nav class="navbar navbar-expand-lg navbar-dark navbar-techstore">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            Tech<span>Store</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal" aria-controls="menuPrincipal"
                aria-expanded="false" aria-label="Abrir menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">

            <ul class="navbar-nav ms-auto">

                

                <li class="nav-item">
                    <a class="nav-link @(controlador == "Home" && accion == "Index" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">Inicio</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(controlador == "Productos" ? "active" : "")"
                       asp-controller="Productos" asp-action="Index">Productos</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(controlador == "Categorias" ? "active" : "")"
                       asp-controller="Categorias" asp-action="Index">Categorias</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(accion == "ContactUs" ? "active" : "")"
                       asp-controller="Home" asp-action="ContactUs">Contactenos</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(accion == "About" ? "active" : "")"
                       asp-controller="Home" asp-action="About">Acerca de nosotros</a>
                </li>
                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor")){
                    <li class="nav-item">
                        <a class="nav-link @(controlador == "Reportes" ? "active" : "")"
                           asp-controller="Reportes" asp-action="Index">Reportes</a>
                    </li>
                }
                @if (User.Identity?.IsAuthenticated == true){
                    <li class="nav-item d-flex align-items-center">
                        <span class="nav-link">
                            Hola, @User.Identity.Name
                        </span>
                    </li>

                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="nav-link btn btn-link">
                                Cerrar sesión
                            </button>
                        </form>
                    </li>
                }
                else{
                    <li class="nav-item">
                        <a class="nav-link @(controlador == "Account" && accion == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(controlador == "Account" && accion == "Register" ? "active" : "")" asp-controller="Account" asp-action="Register">Registrarse</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
