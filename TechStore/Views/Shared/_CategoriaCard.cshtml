@model TechStore.Models.Categoria

@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="col-12 col-sm-6 col-lg-4">

    <div class="d-flex flex-column h-100">

        <a asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@Model.Id"
           class="categoria-card flex-grow-1" style="height:auto;">

            <img src="@Model.Imagen" alt="@Model.Nombre" class="categoria-imagen" />

            <div class="categoria-texto">

                <h3 class="categoria-nombre">@Model.Nombre</h3>

                <p class="categoria-descripcion">@Model.Descripcion</p>

                <span class="categoria-enlace">Ver productos &rarr;</span>

            </div>

        </a>

        @if (controlador == "Categorias")
        {
            <!-- Botones de Editar y Eliminar -->
            <div class="d-flex gap-2 mt-2">
                <a asp-controller="Categorias" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning w-50">
                    Editar
                </a>
                <a asp-controller="Categorias" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger w-50">
                    Eliminar
                </a>
            </div>
        }

    </div>

</div>
