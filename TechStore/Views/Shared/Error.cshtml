@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="container seccion text-center">

    <h1 class="text-danger">Ocurrio un error</h1>

    <p class="texto-largo">
        Ocurrio un error al procesar tu solicitud. Intenta nuevamente
        o regresa a la pagina de inicio.
    </p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Codigo de solicitud:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-principal mt-3">
        Volver al inicio
    </a>

</section>
