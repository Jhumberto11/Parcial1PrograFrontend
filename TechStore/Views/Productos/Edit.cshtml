@model TechStore.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<h2 class="mb-4">Editar Producto</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" class="card p-4 shadow-sm">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-bold"></label>
                <input asp-for="Nombre" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Precio" class="form-label fw-bold"></label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Stock" class="form-label fw-bold">Existencias (Stock)</label>
                    <input asp-for="Stock" type="number" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="CategoriaId" class="form-label fw-bold">Categoría</label>
                <select asp-for="CategoriaId" class="form-select" asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nombre"))">
                    <option value="">-- Selecciona una Categoría --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Imagen" class="form-label fw-bold">Ruta de Imagen</label>
                <input asp-for="Imagen" class="form-control" />
            </div>

            <div class="form-check mb-4">
                <input asp-for="Destacado" class="form-check-input" />
                <label asp-for="Destacado" class="form-check-label fw-bold">Marcar como Producto Destacado</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>