<section class="productos-encabezado">
    <div class="container">

        <h1>Nuestros Productos</h1>

        <p>
            Encuentra computadoras, teléfonos, accesorios y productos
            tecnológicos de calidad a precios competitivos.
        </p>

    </div>
</section>


<section class="productos-seccion">

    <div class="container">

        <div class="row g-4">

            @foreach (var producto in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">

                    <div class="card producto-card h-100">

                       
                        <div class="producto-imagen-contenedor">

                            <img src="@producto.UrlImagen"
                                 class="card-img-top producto-imagen"
                                 alt="@producto.Nombre">

                        </div>


                        

                        <div class="card-body producto-contenido">

                            <h5 class="producto-nombre">
                                @producto.Nombre
                            </h5>

                            <p class="producto-descripcion">
                                @producto.Descripcion
                            </p>




                            <div class="producto-final">

                                <p class="producto-precio">
                                    $@producto.Precio
                                </p>



                                @if (producto.Disponible)
                                {
                                    <span class="text-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="text-danger">Agotado</span>
                                }



                                <a asp-controller="Productos" asp-action="Detalles"
                                   class="btn btn-producto">
                                    Ver producto
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>
