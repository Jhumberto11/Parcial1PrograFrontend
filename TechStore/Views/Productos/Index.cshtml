@model IEnumerable<TechStore.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    var categorias = ViewBag.Categorias as List<TechStore.Models.Categoria>;
    int? categoriaId = ViewBag.CategoriaId;
}

<section class="encabezado-pagina">

    <div class="container">

        <h1>Nuestros Productos</h1>

        <p>
            Encuentra computadoras, telefonos, accesorios y productos
            tecnologicos de calidad a precios competitivos.
        </p>

    </div>

</section>

<section class="container seccion">

    <!-- Filtro por categoria -->
    <div class="filtros">

        <a asp-controller="Productos" asp-action="Index"
           class="filtro @(categoriaId == null ? "filtro-activo" : "")">
            Todos
        </a>

        @if (categorias != null)
        {
            foreach (var categoria in categorias)
            {
                <a asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@categoria.Id"
                   class="filtro @(categoriaId == categoria.Id ? "filtro-activo" : "")">
                    @categoria.Nombre
                </a>
            }
        }

    </div>

    <p class="resultado-conteo">
        @Model.Count() producto(s) encontrado(s)
    </p>

    <div class="row g-4">

        @foreach (var producto in Model)
        {
            <partial name="_ProductCard" model="producto" />
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center">
            No hay productos en esta categoria.
        </div>
    }

</section>
