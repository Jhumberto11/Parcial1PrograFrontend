@model IEnumerable<TechStore.Models.Producto>

@{
    ViewData["Title"] = "Inicio";
    var categorias = ViewBag.Categorias as List<TechStore.Models.Categoria>;
}

<!-- Seccion principal / bienvenida -->
<section class="inicio-principal">

    <div class="container">

        <div class="row align-items-center g-4">

            <div class="col-12 col-lg-7">

                <span class="inicio-etiqueta">Tecnologia para todos</span>

                <h1 class="inicio-titulo">
                    TechStore - Tienda de Tecnologia
                </h1>

                <p class="inicio-texto">
                    Encuentra tecnologia de calidad para estudiar, trabajar,
                    jugar y mantenerte conectado. Ofrecemos computadoras,
                    telefonos y accesorios a precios competitivos.
                </p>

                <div class="inicio-botones">
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-principal">
                        Ver productos
                    </a>
                    <a asp-controller="Categorias" asp-action="Index" class="btn btn-secundario">
                        Ver categorias
                    </a>
                </div>

            </div>

            <div class="col-12 col-lg-5">
                <img src="~/images/computadoras.jpg" alt="Productos de tecnologia"
                     class="inicio-imagen" />
            </div>

        </div>

    </div>

</section>

<!-- Categorias principales -->
<section class="container seccion">

    <h2 class="seccion-titulo">Que puedes encontrar en TechStore</h2>

    <p class="seccion-subtitulo">
        Tenemos diferentes categorias para cubrir distintas necesidades.
    </p>

    <div class="row g-4">

        @if (categorias != null)
        {
            foreach (var categoria in categorias)
            {
                <partial name="_CategoriaCard" model="categoria" />
            }
        }

    </div>

</section>

<!-- Productos destacados -->
<section class="seccion seccion-gris">

    <div class="container">

        <h2 class="seccion-titulo">Productos destacados</h2>

        <p class="seccion-subtitulo">
            Algunos de los productos mas buscados por nuestros clientes.
        </p>

        <div class="row g-4">

            @foreach (var producto in Model)
            {
                <partial name="_ProductCard" model="producto" />
            }

        </div>

        <div class="text-center mt-4">
            <a asp-controller="Productos" asp-action="Index" class="btn btn-principal">
                Ver todos los productos
            </a>
        </div>

    </div>

</section>

<!-- Beneficios -->
<section class="seccion seccion-oscura">

    <div class="container">

        <h2 class="seccion-titulo">Por que comprar en TechStore</h2>

        <div class="row g-4 beneficios">

            <div class="col-12 col-md-4">
                <h3>Productos de calidad</h3>
                <p>
                    Seleccionamos productos tecnologicos confiables
                    y de marcas reconocidas.
                </p>
            </div>

            <div class="col-12 col-md-4">
                <h3>Precios competitivos</h3>
                <p>
                    Buscamos ofrecer buenos precios para que nuestros clientes
                    encuentren tecnologia de acuerdo con su presupuesto.
                </p>
            </div>

            <div class="col-12 col-md-4">
                <h3>Variedad de productos</h3>
                <p>
                    Contamos con diferentes categorias y opciones para cubrir
                    distintas necesidades tecnologicas.
                </p>
            </div>

        </div>

    </div>

</section>
