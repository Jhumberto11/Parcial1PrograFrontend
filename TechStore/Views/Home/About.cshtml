@{
    ViewData["Title"] = "Acerca de nosotros";
}

<section class="encabezado-pagina">

    <div class="container">

        <h1>Acerca de nosotros</h1>

        <p>
            Conoce quienes somos y que buscamos lograr en TechStore.
        </p>

    </div>

</section>

<!-- Historia -->
<section class="container seccion">

    <div class="row align-items-center g-4">

        <div class="col-12 col-lg-6">

            <h2 class="seccion-titulo text-start">Nuestra historia</h2>

            <p class="texto-largo">
                TechStore nacio en el ano 2021 como un pequeno emprendimiento
                dedicado a la venta de accesorios de computadora. Con el tiempo
                fuimos ampliando el catalogo hasta incluir computadoras,
                telefonos y productos de audio.
            </p>

            <p class="texto-largo">
                Hoy atendemos a estudiantes, profesionales y pequenas oficinas
                que buscan tecnologia confiable a un precio justo, con la misma
                atencion cercana con la que empezamos.
            </p>

        </div>

        <div class="col-12 col-lg-6">
            <img src="~/images/accesorios.jpg" alt="Nuestra tienda" class="imagen-redonda" />
        </div>

    </div>

</section>

<!-- Mision y vision -->
<section class="seccion seccion-gris">

    <div class="container">

        <div class="row g-4">

            <div class="col-12 col-md-6">
                <article class="tarjeta-info">
                    <h2>Mision</h2>
                    <p>
                        Ofrecer productos tecnologicos de calidad a precios
                        accesibles, brindando una atencion cercana que ayude a
                        nuestros clientes a elegir la mejor opcion segun sus
                        necesidades.
                    </p>
                </article>
            </div>

            <div class="col-12 col-md-6">
                <article class="tarjeta-info">
                    <h2>Vision</h2>
                    <p>
                        Ser para el ano 2030 una de las tiendas de tecnologia
                        mas reconocidas de El Salvador, destacando por la
                        variedad de nuestro catalogo y por la confianza que
                        nos dan nuestros clientes.
                    </p>
                </article>
            </div>

        </div>

    </div>

</section>

<!-- Valores -->
<section class="container seccion">

    <h2 class="seccion-titulo">Nuestros valores</h2>

    <div class="row g-4">

        <div class="col-12 col-sm-6 col-lg-3">
            <article class="tarjeta-valor">
                <h3>Honestidad</h3>
                <p>Informacion clara sobre cada producto, sin promesas falsas.</p>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <article class="tarjeta-valor">
                <h3>Responsabilidad</h3>
                <p>Cumplimos con lo que ofrecemos y respondemos por cada venta.</p>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <article class="tarjeta-valor">
                <h3>Compromiso</h3>
                <p>Acompanamos al cliente antes, durante y despues de la compra.</p>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <article class="tarjeta-valor">
                <h3>Innovacion</h3>
                <p>Actualizamos el catalogo con lo nuevo del mercado tecnologico.</p>
            </article>
        </div>

    </div>

</section>
