@model TechStore.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="container seccion">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="text-center mb-4">Editar Categoría</h2>

            <form asp-controller="Categorias" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card p-4 shadow-sm">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control" required />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Imagen" class="form-label fw-bold">Ruta de Imagen</label>
                    <input asp-for="Imagen" class="form-control" required />
                    <span asp-validation-for="Imagen" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
