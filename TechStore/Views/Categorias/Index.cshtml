@model IEnumerable<TechStore.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<section class="encabezado-pagina">

    <div class="container">

        <h1>Categorias</h1>

        <p>
            Explora nuestras categorias y encuentra mas rapido
            el producto que estas buscando.
        </p>

    </div>

</section>

<section class="container seccion">

    <div class="row g-4">

        @foreach (var categoria in Model)
        {
            <partial name="_CategoriaCard" model="categoria" />
        }

    </div>

</section>
