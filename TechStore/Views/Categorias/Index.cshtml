@model IEnumerable<TechStore.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<section class="encabezado-pagina">

    <div class="container">

        <h1>Categorias</h1>

        <p>
            Explora nuestras categorias y encuentra mas rapido
            el producto que estas buscando.
        </p>

    </div>

</section>

<section class="container seccion">

    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Categorias" asp-action="Create" class="btn btn-success">Agregar categoría</a>
    </div>

    <p class="resultado-conteo">
        @Model.Count() categoría(s) encontrada(s)
    </p>

    <div class="row g-4">

        @foreach (var categoria in Model)
        {
            <partial name="_CategoriaCard" model="categoria" />
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center">
            No hay categorias registradas.
        </div>
    }

</section>
