@model TechStore.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container seccion">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="text-center mb-4 text-danger">Eliminar Categoría</h2>

            <div class="alert alert-warning shadow-sm border-warning">
                <h4>¿Estás completamente seguro de que deseas eliminar esta categoría?</h4>
                <p class="mb-0">
                    Esta acción no se puede deshacer y también se eliminarán todos los productos que pertenecen a ella.
                </p>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header bg-light">
                    <strong>Detalles de la Categoría a Eliminar</strong>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Nombre:</dt>
                        <dd class="col-sm-9">@Model.Nombre</dd>

                        <dt class="col-sm-3">Descripción:</dt>
                        <dd class="col-sm-9">@Model.Descripcion</dd>

                        <dt class="col-sm-3">Imagen:</dt>
                        <dd class="col-sm-9 text-muted">@Model.Imagen</dd>

                        <dt class="col-sm-3">ID de Referencia:</dt>
                        <dd class="col-sm-9 text-muted">#@Model.Id</dd>
                    </dl>
                </div>
                <div class="card-footer bg-white">
                    <form asp-controller="Categorias" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">Sí, Eliminar Categoría</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar y Volver</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
